{
  "version": 2,
  "builds": [
    {
      "src": "frontend/netflix/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "destination": "/backend/index.js" },
    { "src": "/(.*)", "destination": "/frontend/netflix/dist/$1" }
  ]
}